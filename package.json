{
  "name": "pokerogue-auto-ribbon",
  "version": "0.1.0",
  "description": "Unattended PokéRogue Classic-mode bot that ribbons every starter in the fewest runs. Input-only, no save tampering.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node build.mjs && node harness/smoke.mjs"
  },
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.61.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
